# Kopieer naar /etc/breachout.env (staat bewust NIET in git):
#   sudo cp deploy/breachout.env.example /etc/breachout.env
#   sudo chown root:beheer /etc/breachout.env && sudo chmod 640 /etc/breachout.env
# Maak daarna een eigen geheim, bijvoorbeeld met:  openssl rand -hex 32

BREACHOUT_SECRET=verander-dit-naar-een-lange-willekeurige-tekst

# Cookies alleen via HTTPS. Verwijder deze regel als je zonder HTTPS test (dan blijft inloggen niet hangen).
BREACHOUT_SECURE_COOKIES=1

# Echte omgevingen bouwen/opruimen. Laat leeg (of uitgecommentarieerd) om te simuleren.
# {action} = start | reset | stop | cleanup
#BREACHOUT_ENV_CMD=ansible-playbook /home/beheer/breachout-backend-repo/ansible/challenge.yml -e env_action={action} -e challenge_id={challenge_id} -e user_id={user_id}
#PROXMOX_TOKEN_SECRET=plak-hier-het-api-token-secret
